# Environment Configuration
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# Application
APP_NAME=aws-devops-api
APP_VERSION=1.0.0

# ── Future Integrations (uncomment and fill when needed) ──

# PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=devops_db
# DB_USER=postgres
# DB_PASSWORD=

# Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379

# RabbitMQ
# RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_QUEUE=jobs

# AWS S3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# CloudWatch
# AWS_CLOUDWATCH_LOG_GROUP=/aws/devops-api
